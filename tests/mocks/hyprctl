#!/bin/bash
# Mock hyprctl serving canned JSON from $MOCK_DIR.
case "$1 ${2:-}" in
  "cursorpos -j") cat "$MOCK_DIR/cursorpos.json" 2>/dev/null || echo '{"x": 100, "y": 200}' ;;
  "monitors -j") cat "$MOCK_DIR/monitors.json" 2>/dev/null || echo '[{"name":"DP-1","x":0,"y":0,"width":1920,"height":1080,"scale":1.0,"transform":0,"focused":true}]' ;;
  "activewindow -j") cat "$MOCK_DIR/activewindow.json" 2>/dev/null || echo '{"tags": []}' ;;
  "dispatch hl.dsp.send_shortcut"*)
    echo "$2" >>"$MOCK_DIR/hyprctl.log"
    echo ok
    # copy-suppress: the window has nothing selected, so the shortcut copies
    # nothing. copy-result: an explicit payload (copy_fallback, or a copy that
    # is not the primary selection). Otherwise a live primary selection is
    # copied, which is what a focused window does while that text is highlighted.
    if [[ -f $MOCK_DIR/copy-suppress ]]; then
      :
    elif [[ -f $MOCK_DIR/copy-result ]]; then
      cp "$MOCK_DIR/copy-result" "$MOCK_DIR/clipboard"
    elif [[ -f $MOCK_DIR/primary ]]; then
      cp "$MOCK_DIR/primary" "$MOCK_DIR/clipboard"
    fi
    ;;
  *) echo "mock hyprctl: unsupported: $*" >&2; exit 1 ;;
esac
